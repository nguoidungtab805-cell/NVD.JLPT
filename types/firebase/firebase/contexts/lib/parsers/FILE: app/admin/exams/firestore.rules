// FILE: firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra User đã đăng nhập chưa
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Hàm kiểm tra User có phải là Admin không (dựa vào collection users)
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Bảng Users
    match /users/{userId} {
      // User chỉ được đọc/sửa thông tin của chính mình. Admin được toàn quyền.
      allow read, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Cho phép tạo mới khi đăng ký
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // 2. Dữ liệu học tập (Vocabularies, Kanji, Grammars, Exams)
    match /vocabularies/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /kanji/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /grammars/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /exams/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Lịch sử làm bài (Attempts)
    match /attempts/{attemptId} {
      // User chỉ xem được bài thi của mình.
      allow read: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      // Server (Admin SDK) sẽ tạo bản ghi này khi chấm điểm, nhưng mở allow create cho client nếu dùng cách tính điểm offline. 
      // Do ta dùng API Route (Admin SDK), ta có thể khóa hoàn toàn create từ client để bảo mật tuyệt đối, 
      // nhưng cứ mở cho userId chính chủ để dự phòng linh hoạt:
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
