// Updated rules: allow users to write their own vocab progress
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /vocabularies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /kanji/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grammars/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tests/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /questions/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /results/{resultId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // user vocab progress documents: users/{uid}/vocabProgress/{vocabId}
    match /users/{userId}/vocabProgress/{progressId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['memorized','updatedAt']);
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && request.auth.uid == userId && 
        !(request.resource.data.keys().hasAny(['role']) && request.resource.data.role != resource.data.role);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
  }
}
