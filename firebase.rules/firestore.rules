// Firestore security rules (production-ready patterns)
// Please test carefully in Firebase console simulator.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read of public content (published tests, vocabularies, grammar, kanji)
    match /vocabularies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /kanji/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grammars/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tests/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    match /questions/{docId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Results: user can create their own result and read their own
    match /results/{resultId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Users collection: users can read their own profile, admins can read all
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId; // creation may happen from client (register)
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && request.auth.uid == userId && 
        // cannot change role from client
        !(request.resource.data.keys().hasAny(['role']) && request.resource.data.role != resource.data.role);
      allow delete: if isAdmin();
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
  }
}
